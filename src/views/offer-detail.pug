doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title#pageTitle DODO.NEKO - Szczeg&oacute;&lstrok;y
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='./css/styles.css')
header.header.headerBg
  a.fw-bold.fs-4(href='/')
    | DODO
    span.accent .
    | NEKO
  nav.navBar
    a(href='/offer') Tw&oacute;rczo&sacute;&cacute;
    a(href='/about') O mnie
    a(href='https://www.wattpad.com/user/Dodo_Neko' target='_blank') Wattpad
    a(href='https://plotline.pl/author/dodo-neko' target='_blank') PlotLine
  a.contactBtn.border(href='/contact') Kontakt
main.container.my-5
  // Przycisk powrotu
  .mb-4
    a.text-decoration-none.fw-bold.text-muted(href='/offer')
      | &larr; Powr&oacute;t do oferty
  .page.p-4.p-md-5.mx-auto
    .row.align-items-center.g-4
      .col-md-5.text-center
        img#itemImg.img-fluid.rounded-4.shadow(src='' alt='Okładka' style='max-height: 450px; object-fit: cover;')
      .col-md-7
        span#itemCategory.badge.bg-warning.text-dark.mb-2.px-3.py-2 Kategoria
        h1#itemTitle.fw-bold.display-6.mb-3 &Lstrok;adowanie...
        p#itemDesc.text-secondary.fs-5(style='white-space: pre-line; line-height: 1.7;')
        #linksContainer.mt-4.d-flex.gap-3.flex-wrap
          // Linki wygenerują się automatycznie w JS
footer.footer
  img(src='./img/ytIcon-small.png' alt='YT')
  span.footerTxt dodo.neko
  img(src='./img/gmailIcon-small.png' alt='Email')
  span.footerTxt dodoneko.kontakt@gmail.com
  img(src='./img/igIcon-small.png' alt='IG')
  span.footerTxt dodo.neko
script(type='module' src='./js/details.js')
