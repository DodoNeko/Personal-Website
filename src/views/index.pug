.startPage
  header.header
    a.fw-bold.fs-4(href='')
      | DODO
      span.accent .
      | NEKO
    nav.navBar
      a(href='/offer') Tw&oacute;rczo&sacute;&cacute;
      a(href='/about') O mnie
      a(href='https://www.wattpad.com/user/Dodo_Neko' target='_blank') Wattpad
      a(href='https://plotline.pl/author/dodo-neko' target='_blank') PlotLine
    a.contactBtn(href='/contact') Kontakt
  .startPageCont.container
    div
      .welcomeTxt
        h1.welcomeMain Hej, tu
        h1.welcomeName Dorota
      br
      p Pisarka, ilustratorka i programistka
      span Autorka ilustrowanej historii
      br
      span
        strong Oddzia&lstrok; 20.
        |  na Wattpad i PlotLine
      br
      br
      .startBtns
        a.orangeBtn(href='/offer') Moja tw&oacute;rczo&sacute;&cacute;
        a.whiteBtn(href='/about') O mnie
    div
      img.startMe(src='./img/meStart.jpg' alt='Dorota')
.startSeparator
  span.sepTxt
    | Je&sacute;li kochasz rozbudowane &sacute;wiaty fantasy, wielowymiarowe postaci i mn&oacute;stwo tajemnic
  span.sepHeader Moja tw&oacute;rczo&sacute;&cacute; jest w&lstrok;a&sacute;nie dla Ciebie
.offerPreview.container
  .offerPrevItem
    img.offerImg(src='./img/OddzialOkladka.png' alt='Okładka')
