    span.offerDesc Ilustrowana historia fantasy na Wattpad i PlotLine
    a.checkBtn(href='/offer') Zobacz więcej
  .offerPrevItem
    img.offerImg(src='./img/naklejkiKotki.jpg' alt='Naklejki Kotki')
