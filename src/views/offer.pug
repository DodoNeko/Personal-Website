doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title DODO.NEKO - Tw&oacute;rczo&sacute;&cacute;
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='./css/styles.css')
.d-flex.flex-column.align-items-center.w-100
  header.header.headerBg.mt-0
    a.fw-bold.fs-4(href='/')
      | DODO
      span.accent .
      | NEKO
    nav.navBar
      span.fw-bold.accent Tw&oacute;rczo&sacute;&cacute;
      a(href='/about') O mnie
      a(href='https://www.wattpad.com/user/Dodo_Neko' target='_blank') Wattpad
      a(href='https://plotline.pl/author/dodo-neko' target='_blank') PlotLine
    a.contactBtn.border(href='/contact') Kontakt
  h1.fw-bold.my-4 Tw&oacute;rczo&sacute;&cacute;
  main.page.p-0.m-0.min-vh-100
    .filters.mb-4.text-center
      form#offerFilterForm.d-flex.flex-wrap.justify-content-center.align-items-center.gap-3(method='GET' action='/api/items')
        label.fw-bold(for='categorySelect') Rodzaj
        select#categorySelect.form-select.w-auto(name='category')
          option(value='all') Wszystkie
          option(value='Książka') Ksi&aogon;&zdot;ka
          option(value='Przypinki') Przypinki
          option(value='Naklejki') Naklejki
        label.fw-bold(for='searchInput') Szukaj po frazie
        input#searchInput.form-control.w-auto(type='text' name='search' placeholder='np. Oddział 20')
        button.orangeBtn.border-0(type='submit') Filtruj
        button#resetBtn.whiteBtn.border(type='button') Resetuj
    #offerContainer.offerPreview
  script(type='module' src='./js/offer.js')
footer.footer
  img(src='./img/ytIcon-small.png' alt='YT')
  span.footerTxt dodo.neko
  img(src='./img/gmailIcon-small.png' alt='Email')
  span.footerTxt dodoneko.kontakt@gmail.com
  img(src='./img/igIcon-small.png' alt='IG')
  span.footerTxt dodo.neko
