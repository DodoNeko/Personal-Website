doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title DODO.NEKO - Kontakt
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='./css/styles.css')
.d-flex.flex-column.align-items-center.w-100
  header.header.headerBg
    a.fw-bold.fs-4(href='/')
      | DODO
      span.accent .
      | NEKO
    nav.navBar
      a(href='/offer') Tw&oacute;rczo&sacute;&cacute;
      a(href='/about') O mnie
      a(href='https://www.wattpad.com/user/Dodo_Neko' target='_blank') Wattpad
      a(href='https://plotline.pl/author/dodo-neko' target='_blank') PlotLine
    span.contactBtn.border.fw-bold.text-muted Kontakt
  .contactPage.shadow
    img.contactImg(src='./img/contactImg.jpg' alt='Kontakt')
    .contactFormCont
      h2.mb-4.fw-bold
        | Masz pytania?
        br
        span.accent Skontaktuj si&eogon;!
      form#contactForm
        label.fw-bold Tw&oacute;j E-mail
        input#email(type='email' placeholder='email@domena.pl' required='')
        label.fw-bold Temat
        input#subject(type='text' placeholder='Temat wiadomości' required='')
        label.fw-bold Wiadomo&sacute;&cacute;
        textarea#message(rows='5' placeholder='Wpisz swoją wiadomość...' required='')
        button#submitBtn.orangeBtn.w-100.mt-2(type='submit') Prze&sacute;lij wiadomo&sacute;&cacute;
        #formStatus.mt-3.text-center.font-weight-bold
footer.footer
  img(src='./img/ytIcon-small.png' alt='YT')
  span.footerTxt dodo.neko
  img(src='./img/gmailIcon-small.png' alt='Email')
  span.footerTxt dodoneko.kontakt@gmail.com
  img(src='./img/igIcon-small.png' alt='IG')
  span.footerTxt dodo.neko
script(src='../js/contact.js')
